{
  "name": "open-knowledge",
  "version": "0.1.0",
  "private": true,
  "description": "Course platform built with Next.js and Payload",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:db-schema": "cross-env NODE_OPTIONS=--no-deprecation payload generate:db-schema",
    "generate": "pnpm generate:types && pnpm generate:importmap && pnpm generate:db-schema",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@payloadcms/db-postgres": "4.0.0-beta.2",
    "@payloadcms/email-nodemailer": "4.0.0-beta.2",
    "@payloadcms/live-preview-react": "4.0.0-beta.2",
    "@payloadcms/next": "4.0.0-beta.2",
    "@payloadcms/plugin-seo": "4.0.0-beta.2",
    "@payloadcms/richtext-lexical": "4.0.0-beta.2",
    "@payloadcms/storage-s3": "4.0.0-beta.2",
    "@payloadcms/transformer-sharp": "4.0.0-beta.2",
    "@payloadcms/ui": "4.0.0-beta.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "drizzle-orm": "^0.45.4",
    "graphql": "^16.8.1",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.2",
    "payload": "4.0.0-beta.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.3",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.12.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.24.0"
}
