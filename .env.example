# Copy to .env and fill in. Values below match docker-compose.yml for local development.

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/open_knowledge

# Payload (openssl rand -hex 32)
PAYLOAD_SECRET=

# Better Auth (openssl rand -hex 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers. A provider is enabled only when both values are set.
# Google callback:  {BETTER_AUTH_URL}/api/auth/callback/google
# GitHub callback:  {BETTER_AUTH_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email. Local: Mailpit (UI at http://localhost:8025)
# Production: Resend SMTP -> SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend SMTP_PASS=<api key>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=hello@open-knowledge.local
EMAIL_FROM_NAME=Open Knowledge

# S3-compatible storage. Local: SeaweedFS. Production: Cloudflare R2
# R2 -> S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com S3_REGION=auto
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=media
S3_REGION=auto
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-key

# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base URL where uploaded files are publicly readable (R2 custom domain in production)
NEXT_PUBLIC_MEDIA_URL=http://localhost:8333/media
